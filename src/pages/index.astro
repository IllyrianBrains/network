---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/network.css';
import communitiesCsv from '../../data/communities.csv?raw';
import professionalGroupsCsv from '../../data/professional-groups.csv?raw';
import professionalConnectionsCsv from '../../data/professional-connections.csv?raw';
import { cities as cityLocations } from '../data/cities';

const parseCsv = (raw:string) => { const [header,...rows]=raw.trim().split(/\r?\n/); const keys=header.split(','); return rows.map(row=>Object.fromEntries(keys.map((key,index)=>[key,row.split(',')[index]??'']))); };
const parseNodes = (raw:string) => parseCsv(raw).map(record=>({ ...record, established_year:Number(record.established_year), events_count:Number(record.events_count), participants_count:Number(record.participants_count), event_attendance_total:Number(record.event_attendance_total), tags:record.tags.split(';') }));
const parseConnections = (raw:string) => parseCsv(raw).map(record=>({ ...record, people_count:Number(record.people_count), tags:record.tags.split(';') }));
const locationAliases:Record<string,string> = { Cologne:'Köln / Cologne', Cheltenham:'South England (Cheltenham)', Florence:'Firenze', Genoa:'Genova', Milan:'Milano', Rome:'Roma', 'Washington DC':'Washington' };
const communities = parseNodes(communitiesCsv).map((community) => { const location=cityLocations.find(item=>item.city===(locationAliases[community.city]??community.city)); return {...community,lat:location?.lat,lng:location?.lng}; });
const professionalGroups = parseNodes(professionalGroupsCsv);
const regions = [...new Set(communities.map((community) => community.region))].map((name) => ({ name, count:communities.filter((community) => community.region === name).length }));
const regionLabels:Record<string,string> = { Europe:'Evropë', 'North America':'Amerikë e Veriut', Balkans:'Ballkan', 'Middle East':'Lindje e Mesme' };
const tags = [...new Set([...communities, ...professionalGroups].flatMap((community) => community.tags))].sort();
const professionalConnections = parseConnections(professionalConnectionsCsv);
const ideas = [
  { title:'AI dhe teknologjitë e reja', tag:'Teknologji', people:286, body:'Ndërtues, studiues dhe operatorë që formësojnë gjeneratën e ardhshme të produkteve inteligjente.', links:['Berlin','Londër','San Jose'] },
  { title:'Themelues përtej kufijve', tag:'Sipërmarrje', people:194, body:'Një rreth i besuar për njohuri tregu, kapital dhe rrugë praktike drejt zgjerimit.', links:['Nju Jork','Tiranë','Zyrih'] },
  { title:'Dija kthehet në Shqipëri', tag:'Ndikim', people:163, body:'Përvoja e diasporës shndërrohet në mentorim, edukim dhe kapacitet afatgjatë.', links:['Tiranë','Vjenë','Boston'] },
  { title:'Qytete më të mira', tag:'Urbanizëm', people:89, body:'Ide për hapësirën publike, arkitekturën, lëvizshmërinë dhe qytete më njerëzore.', links:['Tiranë','Kopenhagë','Milano'] },
  { title:'Gratë ndërtojnë të ardhmen', tag:'Lidership', people:147, body:'Një rrjet në rritje për dukshmëri, mbështetje dhe brezin e ri të lidereve shqiptare.', links:['Londër','Berlin','Toronto'] },
  { title:'Kultura si infrastrukturë', tag:'Kulturë', people:72, body:'Artistë, teknologë dhe tregimtarë të lidhur rreth një të ardhmeje të përbashkët kulturore.', links:['Paris','Pragë','Shkup'] },
];
---
<BaseLayout title="Rrjeti · Illyrian Brains" description="Eksploroni njerëzit, komunitetet dhe idetë që përbëjnë rrjetin global Illyrian Brains.">
<div class="network-page">
  <header class="network-header">
    <div class="network-header-inner">
      <a class="network-brand" href="#top"><img src="/assets/logo.png" alt="Illyrian Brains network" /></a>
      <nav aria-label="Navigimi kryesor"><a class="is-active" href="#explore">Rrjeti</a><a href="#ideas">Idetë</a><a href="#about">Rreth nesh</a></nav>
      <a class="join-link" href="mailto:illyrianbrains@gmail.com?subject=Bashkohu%20me%20rrjetin%20Illyrian%20Brains">Bashkohu <span>↗</span></a>
    </div>
  </header>
  <main id="top">
    <section class="network-hero">
      <div class="hero-grid" aria-hidden="true"></div><div class="hero-orbit orbit-one" aria-hidden="true"></div><div class="hero-orbit orbit-two" aria-hidden="true"></div>
      <div class="hero-copy"><p class="network-kicker"><span></span>Illyrian Brains Network</p><h1>Rrjeti shqiptar i<br /><em>profesionistëve.</em></h1><p class="hero-lead">Zhvillim në karrierë, lehtësira në integrim dhe miqësi që i qëndrojnë kohës—këto mund të t’i ofrojë një komunitet i gjerë që flet gjuhën tënde.</p><div class="hero-actions"><a class="primary-action" href="#explore">Eksploro komunitetet <span>↓</span></a><a class="text-action" href="#about">Mëso më shumë <span>↗</span></a></div></div>
      <figure class="hero-community-photo"><img src="/assets/inst_global.png" alt="Anëtarë të rrjetit Illyrian Brains gjatë një takimi të komunitetit" /><figcaption><span>Komuniteti ynë</span><strong>Njohje që kthehen në bashkëpunime.</strong></figcaption></figure>
      <div class="hero-index"><div><strong>52</strong><span>Komunitete</span></div><div><strong>5k+</strong><span>Anëtarë</span></div><div><strong>100+</strong><span>Fusha interesi</span></div></div>
    </section>
    <section class="explorer" id="explore">
      <div class="explorer-intro"><div><p class="section-label">Direktoria e rrjetit · 2026</p><h2>Shihni ku jemi.<br />Zbuloni çfarë na lidh.</h2></div><p>Jo thjesht një listë kontaktesh, por një pamje e një komuniteti të gjallë—i organizuar rreth vendeve, profesioneve dhe interesave të përbashkëta.</p></div>
      <nav class="folder-tabs network-folder-tabs" aria-label="Pamjet e rrjetit"><button class="is-active" data-network="cities"><span>01</span> Komunitetet lokale</button><button data-network="professions"><span>02</span> Grupet profesionale</button></nav>
      <div class="explorer-toolbar"><label class="search-box"><span aria-hidden="true"></span><input id="network-search" type="search" placeholder="Kërko qytet, shtet ose etiketë…" autocomplete="off" /></label><div class="group-control"><label for="region-filter">Rajoni</label><select id="region-filter"><option value="all">Të gjitha rajonet</option>{regions.map(region=><option value={region.name}>{regionLabels[region.name] ?? region.name}</option>)}</select></div><div class="group-control"><label for="status-filter">Statusi</label><select id="status-filter"><option value="all">Të gjitha</option><option value="active">Aktiv</option><option value="forming">Në formim</option><option value="inactive">Joaktiv</option></select></div><div class="group-control"><label for="group-by">Grupo sipas</label><select id="group-by" disabled><option value="none">Pa grupim</option><option value="region">Rajonit</option><option value="country">Shtetit</option><option value="primary_focus">Fokusit</option><option value="activity">Aktivitetit</option><option value="tag">Etiketës kryesore</option></select></div><div class="tag-filter compact-tag-filter"><span>Etiketa</span><select id="tag-filter"><option value="all">Të gjitha</option>{tags.map(tag=><option value={tag}>{tag}</option>)}</select></div><button class="clear-all" id="clear-filter">Pastro filtrat</button></div>
      <div class="explorer-shell" data-communities={JSON.stringify(communities)} data-professional-groups={JSON.stringify(professionalGroups)} data-professional-connections={JSON.stringify(professionalConnections)}>
        <aside class="filter-rail" aria-hidden="true"></aside>
        <div class="network-canvas" id="network-canvas"><div id="city-map" aria-label="Harta e komuniteteve lokale"></div><div id="cytoscape-network" class="is-hidden" aria-label="Graf interaktiv i grupeve profesionale"></div><div class="canvas-legend"><span><i class="legend-city"></i> Madhësia e rrethit = pjesëmarrësit në komunitet</span><span class="network-only"><i class="legend-link"></i> Trashësia e vijës = njerëzit lidhës</span></div><div class="canvas-caption"><span id="visible-count">52 komunitete</span><span id="canvas-instruction">Zgjidh një qytet · zmadho dhe lëviz hartën</span></div><div class="zoom-controls network-only"><button id="network-zoom-in" aria-label="Zmadho">+</button><button id="network-zoom-out" aria-label="Zvogëlo">−</button><button id="network-fit" aria-label="Përshtat rrjetin">⌂</button></div></div>
        <aside class="city-directory"><header><div><p class="section-label">Rezultatet</p><h3 id="directory-title">Qytetet e rrjetit</h3></div><strong id="directory-count">52</strong></header><div class="city-entry-list" id="city-entry-list"></div></aside>
        <aside class="detail-panel" id="detail-panel"><button class="detail-close" aria-label="Mbylle">×</button><p class="section-label">Profili i komunitetit</p><span class="detail-country">Gjermani</span><h3>Berlin</h3><p class="detail-summary">Aktiviteti dhe interesat nga të dhënat e rrjetit.</p><div class="detail-stats"><div><strong data-stat="participants">—</strong><span>Pjesëmarrës</span></div><div><strong data-stat="events">—</strong><span>Evente</span></div><div><strong data-stat="attendance">—</strong><span>Pjesëmarrje totale</span></div></div><div class="detail-topics"></div><small class="detail-source">Të dhëna fillestare · në verifikim</small><a href="mailto:illyrianbrains@gmail.com?subject=Komuniteti%20Illyrian%20Brains">Lidhu me komunitetin <span>↗</span></a></aside>
      </div>
    </section>
    <section class="ideas-section" id="ideas"><header class="ideas-heading"><div><p class="section-label">Ide në qarkullim</p><h2>Për çfarë po mendon<br />rrjeti.</h2></div><p>Pyetjet e përbashkëta kthehen në biseda. Bisedat bëhen grupe pune, bashkëpunime dhe iniciativa të reja.</p></header><div class="idea-grid">{ideas.map((idea,index)=><article class="idea-card" data-search={`${idea.title} ${idea.tag} ${idea.links.join(' ')}`.toLowerCase()}><div class="idea-card-top"><span>{String(index+1).padStart(2,'0')}</span><small>{idea.tag}</small></div><h3>{idea.title}</h3><p>{idea.body}</p><div class="idea-links">{idea.links.map(link=><span>{link}</span>)}</div><footer><span>{idea.people} njerëz të lidhur</span><b>↗</b></footer></article>)}</div></section>
    <section class="about-section" id="about"><div class="about-mark">IB</div><div class="about-copy"><p class="network-kicker"><span></span>Një rrjet i hapur</p><h2>Ndërtuar mbi besim.<br />I dobishëm përmes pjesëmarrjes.</h2></div><div class="about-body"><p>Illyrian Brains lidh njerëzit përmes komuniteteve lokale dhe interesave profesionale. Harta i bën këto lidhje të dukshme—që dija të udhëtojë më larg dhe njerëzit e duhur të gjejnë njëri-tjetrin.</p><a href="mailto:illyrianbrains@gmail.com?subject=Bashkohu%20me%20rrjetin%20Illyrian%20Brains">Shto veten në hartë <span>↗</span></a></div></section>
  </main>
  <footer class="network-footer"><img src="/assets/logo.png" alt="Rrjeti Illyrian Brains" /><p>Lidhim mendjet. Ndërtojmë të ardhmen.</p><span>© 2026 Illyrian Brains Network</span></footer>
</div>
<script>
import L from 'leaflet';
import cytoscape from 'cytoscape';
const shell=document.querySelector('.explorer-shell'),canvas=document.querySelector('#network-canvas'),detail=document.querySelector('#detail-panel'),search=document.querySelector('#network-search'),communityData=JSON.parse(shell?.dataset.communities||'[]'),professionalData=JSON.parse(shell?.dataset.professionalGroups||'[]'),professionalLinks=JSON.parse(shell?.dataset.professionalConnections||'[]');
let activeNetwork='cities',activeGroup='none',activeTag='all',activeRegion='all',activeStatus='all',cy,map,markerLayer,ambientTimer,interactionPause=0;const markers=new Map();
const slug=value=>value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-');
const countrySq={Germany:'Gjermani',Switzerland:'Zvicër',Austria:'Austri',Denmark:'Danimarkë',Finland:'Finlandë',Poland:'Poloni',Sweden:'Suedi',Norway:'Norvegji',Czechia:'Çeki',Netherlands:'Holandë',Belgium:'Belgjikë',Ireland:'Irlandë','United Kingdom':'Mbretëria e Bashkuar',Luxembourg:'Luksemburg',Spain:'Spanjë',France:'Francë',Italy:'Itali',Malta:'Maltë',Albania:'Shqipëri','United States':'SHBA',Canada:'Kanada','United Arab Emirates':'Emiratet e Bashkuara Arabe','North Macedonia':'Maqedonia e Veriut'};
const activityFor=c=>c.events_count>=30?'Aktivitet i lartë':c.events_count>=15?'I konsoliduar':c.events_count>=8?'Në rritje':'Në formim';
function groupFor(c){if(activeGroup==='region'&&c.region)return c.region;if(activeGroup==='country'&&c.country)return c.country;if(activeGroup==='primary_focus')return c.primary_focus;if(activeGroup==='activity')return activityFor(c);if(activeGroup==='tag')return c.tags[0]||'untagged';return null}
function graphElements(){const isCities=activeNetwork==='cities',rawNodes=isCities?communityData:professionalData,rawLinks=isCities?[]:professionalLinks,q=search.value.trim().toLowerCase();const networkNodes=rawNodes.map(item=>({...item,country:countrySq[item.country]||item.country,network_id:isCities?item.community_id:item.group_id,label:isCities?item.city:item.name})).filter(item=>(activeRegion==='all'||!isCities||item.region===activeRegion)&&(activeStatus==='all'||item.status===activeStatus)&&(activeTag==='all'||item.tags.includes(activeTag))&&`${item.label} ${item.country||''} ${item.primary_focus} ${item.tags.join(' ')}`.toLowerCase().includes(q));const elements=[],groups=new Map(),visibleIds=new Set(networkNodes.map(item=>item.network_id));networkNodes.forEach(item=>{const group=groupFor(item),groupId=group?'group-'+slug(group):null;if(groupId&&!groups.has(groupId)){groups.set(groupId,true);elements.push({data:{id:groupId,label:group},classes:'network-group'})}elements.push({data:{...item,id:'node-'+item.network_id,parent:groupId||undefined,activity:activityFor(item)},classes:'community '+(item.participants_count>=300?'featured':'')})});const links=rawLinks.map(link=>({...link,source_id:link.source_group_id,target_id:link.target_group_id})).filter(link=>visibleIds.has(link.source_id)&&visibleIds.has(link.target_id)&&(activeTag==='all'||link.tags.includes(activeTag)));links.forEach(link=>elements.push({data:{...link,id:'connection-'+link.connection_id,source:'node-'+link.source_id,target:'node-'+link.target_id,label:String(link.people_count)},classes:'people-connection'}));return {elements,networkNodes,links,isCities}}
function render(){const result=graphElements();clearInterval(ambientTimer);renderDirectory(result);document.querySelector('#city-map').classList.toggle('is-hidden',!result.isCities);document.querySelector('#cytoscape-network').classList.toggle('is-hidden',result.isCities);document.querySelectorAll('.network-only').forEach(item=>item.classList.toggle('is-hidden',result.isCities));document.querySelector('#canvas-instruction').textContent=result.isCities?'Zgjidh një qytet · zmadho dhe lëviz hartën':'Zgjidh · zmadho · tërhiq nyjet për ta lëvizur rrjetin';if(result.isCities){if(cy){cy.destroy();cy=null}renderCityMap(result);return}if(cy)cy.destroy();cy=cytoscape({container:document.querySelector('#cytoscape-network'),elements:result.elements,minZoom:.18,maxZoom:2.8,wheelSensitivity:.18,style:[
{selector:'node.community',style:{'shape':'ellipse','width':'mapData(participants_count, 40, 820, 46, 138)','height':'mapData(participants_count, 40, 820, 46, 138)','background-color':'#f4eaef','border-width':'mapData(events_count, 4, 64, 1, 4)','border-color':'#8b526e','label':'data(label)','color':'#29242a','font-family':'Inter','font-size':'mapData(participants_count, 40, 820, 9, 16)','font-weight':600,'text-valign':'center','text-wrap':'wrap','text-max-width':'100px'}},
{selector:'node.community.featured',style:{'background-color':'#ead8e1','border-color':'#744761'}},
{selector:'node.network-group',style:{'shape':'round-rectangle','background-color':'#f8f7f5','background-opacity':.8,'border-width':1,'border-style':'dashed','border-color':'#c9c4c0','padding':'50px','label':'data(label)','color':'#8a8588','font-family':'Inter','font-size':'16px','font-weight':600,'text-valign':'top','text-margin-y':'-14px'}},
{selector:'edge.people-connection',style:{'curve-style':'bezier','width':'mapData(people_count, 8, 205, 1, 12)','line-color':'#a8a1a5','opacity':.62,'label':'data(label)','font-family':'Inter','font-size':'9px','font-weight':700,'color':'#5c565a','text-background-color':'#fff','text-background-opacity':.92,'text-background-padding':'3px','text-rotation':'autorotate','overlay-padding':'8px'}},
{selector:'edge.people-connection:selected',style:{'line-color':'#8b526e','opacity':1,'z-index':100,'font-size':'12px','color':'#744761'}},
{selector:'.faded',style:{'opacity':.08}},{selector:'.focused',style:{'opacity':1,'z-index':99}}
],layout:{name:'cose',animate:'end',animationDuration:850,animationEasing:'ease-out',fit:true,padding:70,nodeRepulsion:900000,idealEdgeLength:165,edgeElasticity:120,nestingFactor:1.2,gravity:.14,numIter:1100,componentSpacing:90}});
document.querySelector('#visible-count').textContent=`${result.networkNodes.length} ${result.isCities?'komunitete lokale':'grupe profesionale'} · ${result.networkNodes.reduce((n,c)=>n+c.participants_count,0).toLocaleString()} pjesëmarrës · ${result.links.reduce((n,c)=>n+c.people_count,0).toLocaleString()} njerëz lidhës`;
cy.on('tap','node.community',event=>focusNode(event.target));cy.on('tap','edge.people-connection',event=>{const edge=event.target;cy.elements().addClass('faded');edge.union(edge.connectedNodes()).addClass('focused').removeClass('faded')});cy.on('tap',event=>{if(event.target===cy){cy.elements().removeClass('faded focused');closeDetail();document.querySelectorAll('.city-entry').forEach(card=>card.classList.remove('is-active'))}});cy.on('grab drag',()=>{interactionPause=Date.now()+4000});cy.on('free',event=>{event.target.stop();interactionPause=Date.now()+2500});cy.one('layoutstop',startAmbientMotion);setTimeout(startAmbientMotion,1100)}
function renderCityMap(result){if(!map){map=L.map('city-map',{zoomControl:true,scrollWheelZoom:true,minZoom:2,preferCanvas:true,worldCopyJump:true}).setView([50.2,10],4);L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'}).addTo(map);markerLayer=L.layerGroup().addTo(map);map.on('zoomend',resizeMapMarkers)}markerLayer.clearLayers();markers.clear();const bounds=[];result.networkNodes.forEach(city=>{if(!Number.isFinite(city.lat)||!Number.isFinite(city.lng))return;const baseRadius=Math.max(7,Math.min(27,4+Math.sqrt(city.participants_count)*.78)),marker=L.circleMarker([city.lat,city.lng],{radius:baseRadius,color:'#744761',weight:2,fillColor:'#a66f8a',fillOpacity:.68,bubblingMouseEvents:false});marker._baseRadius=baseRadius;marker.bindTooltip(`<strong>${city.label}</strong><span>${city.participants_count.toLocaleString()} pjesëmarrës · ${city.events_count} evente</span>`,{direction:'top',className:'community-map-tooltip',offset:[0,-4]});marker.on('click',()=>focusMapEntry(city.network_id,marker));marker.on('mouseover',()=>marker.setStyle({fillOpacity:.9,weight:3}));marker.on('mouseout',()=>marker.setStyle({fillOpacity:.68,weight:2}));marker.addTo(markerLayer);markers.set(city.network_id,marker);bounds.push([city.lat,city.lng])});setTimeout(()=>{map.invalidateSize(true);if(activeRegion==='all')map.setView([50.2,10],4,{animate:true});else if(bounds.length)map.fitBounds(bounds,{padding:[55,55],maxZoom:6});else map.setView([50.2,10],4);setTimeout(resizeMapMarkers,120)},80);document.querySelector('#visible-count').textContent=`${result.networkNodes.length} qytete · ${result.networkNodes.reduce((n,c)=>n+c.participants_count,0).toLocaleString()} pjesëmarrës · ${result.networkNodes.reduce((n,c)=>n+c.events_count,0)} evente`}
function resizeMapMarkers(){if(!map)return;const factor=Math.max(.68,Math.min(1.22,.48+map.getZoom()*.12));markers.forEach(marker=>marker.setRadius(marker._baseRadius*factor))}
function focusMapEntry(id,marker){document.querySelectorAll('.city-entry').forEach(card=>card.classList.toggle('is-active',card.dataset.nodeId===`node-${id}`));const card=document.querySelector(`[data-node-id="node-${id}"]`);card?.scrollIntoView({block:'nearest',behavior:'smooth'});map.flyTo(marker.getLatLng(),Math.max(map.getZoom(),6),{duration:.65});marker.openTooltip()}
function focusNode(node){cy.elements().addClass('faded');node.union(node.connectedEdges()).union(node.neighborhood('node')).addClass('focused').removeClass('faded');document.querySelectorAll('.city-entry').forEach(card=>card.classList.toggle('is-active',card.dataset.nodeId===node.id()));const card=document.querySelector(`[data-node-id="${node.id()}"]`);card?.scrollIntoView({block:'nearest',behavior:'smooth'})}
function renderDirectory(result){const list=document.querySelector('#city-entry-list'),statusSq={active:'Aktiv',forming:'Në formim',inactive:'Joaktiv'};document.querySelector('#directory-title').textContent=result.isCities?'Qytetet e rrjetit':'Grupet profesionale';document.querySelector('#directory-count').textContent=result.networkNodes.length;list.innerHTML=result.networkNodes.sort((a,b)=>b.participants_count-a.participants_count).map(item=>`<button class="city-entry" data-node-id="node-${item.network_id}"><span class="city-entry-main"><strong>${item.label}</strong><small>${[item.country,statusSq[item.status]].filter(Boolean).join(' · ')}</small></span><span class="city-entry-metrics"><b>${item.participants_count.toLocaleString()}</b><small>pjesëmarrës</small></span><span class="city-entry-events"><b>${item.events_count}</b><small>evente</small></span><span class="city-entry-tags">${item.tags.slice(0,3).map(tag=>`<i>${tag}</i>`).join('')}</span></button>`).join('');list.querySelectorAll('.city-entry').forEach(card=>card.onclick=()=>{if(result.isCities){const id=card.dataset.nodeId.replace('node-',''),marker=markers.get(id);if(marker)focusMapEntry(id,marker)}else{const node=cy.getElementById(card.dataset.nodeId);if(node.length){focusNode(node);cy.animate({center:{eles:node},zoom:Math.max(cy.zoom(),.9),duration:350})}}})}
function startAmbientMotion(){clearInterval(ambientTimer);ambientTimer=setInterval(()=>{if(!cy||Date.now()<interactionPause||document.hidden)return;const candidates=cy.nodes('.community:visible').filter(node=>!node.selected());if(!candidates.length)return;const node=candidates[Math.floor(Math.random()*candidates.length)],position=node.position();node.animate({position:{x:position.x+(Math.random()-.5)*12,y:position.y+(Math.random()-.5)*12}},{duration:2400,easing:'ease-in-out-cubic'});},700)}
function openDetail(data){detail.querySelector('.detail-country').textContent=[data.country,data.activity].filter(Boolean).join(' · ');detail.querySelector('h3').textContent=data.label;detail.querySelector('[data-stat="participants"]').textContent=data.participants_count.toLocaleString();detail.querySelector('[data-stat="events"]').textContent=data.events_count.toLocaleString();detail.querySelector('[data-stat="attendance"]').textContent=data.event_attendance_total.toLocaleString();detail.querySelector('.detail-topics').innerHTML=data.tags.map(tag=>`<span>${tag}</span>`).join('');detail.querySelector('.detail-source').textContent=data.data_status==='seed'?'Të dhëna fillestare · në verifikim':'Të dhëna të verifikuara';detail.classList.add('is-open');canvas.classList.add('has-detail');setTimeout(()=>cy.resize(),320)}
function closeDetail(){detail.classList.remove('is-open');canvas.classList.remove('has-detail');setTimeout(()=>{cy.resize();cy.fit(undefined,45)},320)}
detail.querySelector('.detail-close').onclick=closeDetail;document.querySelector('#clear-filter').onclick=()=>{activeTag='all';activeGroup='none';activeRegion='all';activeStatus='all';search.value='';document.querySelector('#tag-filter').value='all';document.querySelector('#group-by').value='none';document.querySelector('#region-filter').value='all';document.querySelector('#status-filter').value='all';render()};document.querySelector('#group-by').onchange=event=>{activeGroup=event.target.value;render()};document.querySelector('#tag-filter').onchange=event=>{activeTag=event.target.value;render()};document.querySelector('#region-filter').onchange=event=>{activeRegion=event.target.value;render()};document.querySelector('#status-filter').onchange=event=>{activeStatus=event.target.value;render()};document.querySelectorAll('[data-network]').forEach(button=>button.onclick=()=>{activeNetwork=button.dataset.network;activeTag='all';activeRegion='all';activeGroup='none';document.querySelector('#tag-filter').value='all';document.querySelector('#region-filter').value='all';document.querySelector('#group-by').value='none';document.querySelector('#region-filter').disabled=activeNetwork!=='cities';document.querySelector('#group-by').disabled=activeNetwork==='cities';document.querySelectorAll('[data-network]').forEach(b=>b.classList.toggle('is-active',b===button));render()});let timer;search.oninput=()=>{clearTimeout(timer);timer=setTimeout(render,180)};document.querySelector('#network-zoom-in').onclick=()=>cy&&cy.zoom({level:cy.zoom()*1.25,renderedPosition:{x:cy.width()/2,y:cy.height()/2}});document.querySelector('#network-zoom-out').onclick=()=>cy&&cy.zoom({level:cy.zoom()*.8,renderedPosition:{x:cy.width()/2,y:cy.height()/2}});document.querySelector('#network-fit').onclick=()=>cy&&cy.fit(undefined,55);render();
</script>
</BaseLayout>
